# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# local env files
*/.env
*/.env.*.local

# Native
frontend/.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# typescript
*.tsbuildinfo

# Expo
.expo/
frontend/dist/
frontend/web-build/
frontend/expo-env.d.ts

# dependencies
frontend/node_modules/

# Metro
frontend/.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# generated native folders
frontend/ios
frontend/android

# ML
ml/data/train
ml/data/test
ml/training/__pycache__
ml/venv

# Terraform
infra/.terraform/
infra/terraform.tfstate
infra/*.backup
infra/.terraform.lock.hcl
infra/.terragrunt-cache/
infra/terraform.tfvars

# Sensitive files - DO NOT COMMIT
*.pem
*.key

# Lambda deployment packages
infra/lambda-functions/dist
infra/lambda-functions/**/node_modules/

# macOS
.DS_Store